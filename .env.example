# Copy to .env and fill in the keys you actually have.
# .env is gitignored. Any link whose provider has no key is skipped, so a
# partly filled file is fine — the chain just gets shorter.
#
# Check what resolved:  node bin/freechain.mjs --status

# ── Multiple keys per provider ────────────────────────────────────────
# Rate limits are usually per account, not per provider. Give a provider
# several keys and freechain rotates through them before moving down the
# chain. Three interchangeable forms, all optional:
#
#   FREECHAIN_OPENROUTER_API_KEY    = sk-a              one key
#   FREECHAIN_OPENROUTER_API_KEYS   = sk-a,sk-b,sk-c    comma or space list
#   FREECHAIN_OPENROUTER_API_KEY_1  = sk-a              numbered, 1..32
#   FREECHAIN_OPENROUTER_API_KEY_2  = sk-b
#
# Mix them freely; duplicates are collapsed and order is preserved.
# Every provider below supports all three forms.

# ── OpenRouter ── https://openrouter.ai/keys
FREECHAIN_OPENROUTER_API_KEYS=

# ── OpenCode Zen ── https://opencode.ai/zen
FREECHAIN_OPENCODE_ZEN_API_KEYS=

# ── OmniRoute ── self-hosted router on loopback, usually needs no key
# FREECHAIN_OMNIROUTE_API_KEY=

# ── Optional extras ── add matching entries to chain.config.json to use
# FREECHAIN_LONGCAT_API_KEYS=
# FREECHAIN_GROQ_API_KEYS=
# FREECHAIN_CEREBRAS_API_KEYS=
# FREECHAIN_NVIDIA_API_KEYS=
# FREECHAIN_DEEPSEEK_API_KEYS=
# FREECHAIN_GOOGLE_API_KEYS=
# FREECHAIN_OPENAI_API_KEYS=

# ── Server ──
# FREECHAIN_PORT=4853
# FREECHAIN_HOST=127.0.0.1
