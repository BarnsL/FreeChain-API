{
  "name": "freechain",
  "version": "0.7.1",
  "description": "OpenAI-compatible failover router over a chain of free and paid model providers",
  "type": "module",
  "bin": {
    "freechain": "bin/freechain.mjs",
    "freechain-import-presets": "bin/import-presets.mjs"
  },
  "exports": {
    ".": "./src/chain.js"
  },
  "scripts": {
    "start": "node bin/freechain.mjs",
    "test": "node --test \"test/*.test.js\"",
    "import-presets": "node bin/import-presets.mjs",
    "build": "node scripts/build-release.mjs",
    "build-guide-docs": "node scripts/build-guide-docs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarnsL/FreeChain-API.git"
  },
  "keywords": [
    "openai",
    "llm",
    "failover",
    "router",
    "proxy",
    "openrouter",
    "free-models"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "rcedit": "^5.0.2"
  }
}
